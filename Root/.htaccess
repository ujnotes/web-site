DirectoryIndex Framework/HTML/Page.php

RewriteRule ^404$ /Framework/HTML/404.php [L]

RewriteBase /
RewriteEngine On
DirectorySlash Off

# Canonical AJAX payloads. Must run before File/Site catch-alls and before
# Apache could negotiate a sibling directory named like the slug.
RewriteRule ^(.*?)\.json$ Framework/HTML/Component.php [L]

RewriteRule ^(.+)/$ $1 [R=301]

RewriteRule ^aboutme$ about_me [R=307,L]

RewriteRule ^facebook$ https://facebook.com/ujnotes [R=307,L]
RewriteRule ^twitter$ https://twitter.com/ujnotesx [R=307,L]
RewriteRule ^gplus$ https://plus.google.com/+ujnotesx [R=307,L]
RewriteRule ^patreon$ https://patreon.com/ujnotes [R=307,L]

RewriteRule ^philosophy$ world/philosophy [R=301,L]
RewriteRule ^life$ world/philosophy/life [R=301,L]
RewriteRule ^death$ world/philosophy/death [R=301,L]
RewriteRule ^god$ world/philosophy/god [R=301,L]
RewriteRule ^no_god$ world/philosophy/god/no_god [R=301,L]
RewriteRule ^nogod$ world/philosophy/god/no_god [R=301,L]
RewriteRule ^problem$ world/philosophy/problem [R=301,L]
RewriteRule ^solution$ world/philosophy/solution [R=301,L]

RewriteRule ^computer/dos$ computer/os [R=301,L]
RewriteRule ^computer/dprogram$ computer/program [R=301,L]
RewriteRule ^computer/dprogramming$ computer/programming [R=301,L]

RewriteRule ^world/philosophy/algorithm$ computer/algorithm [R=301,L]
RewriteRule ^world/philosophy/program$ computer/program [R=301,L]
RewriteRule ^world/philosophy/artificial-intelligence$ technology/computer/artificial_intelligence [R=301,L]
RewriteRule ^computer/technology/algorithms$ computer/algorithm [R=301,L]
RewriteRule ^computer/technology/algorithms/(.+)$ computer/algorithm/$1 [R=301,L]
RewriteRule ^computer/technology/machine_learning$ technology/computer/artificial_intelligence/machine_learning [R=301,L]
RewriteRule ^computer/technology/machine_learning/(.+)$ technology/computer/artificial_intelligence/machine_learning/$1 [R=301,L]
RewriteRule ^computer/technology$ technology/computer [R=301,L]
RewriteRule ^computer/technology/(.+)$ technology/computer/$1 [R=301,L]
RewriteRule ^technology/computer/machine_learning$ technology/computer/artificial_intelligence/machine_learning [R=301,L]
RewriteRule ^technology/computer/machine_learning/(.+)$ technology/computer/artificial_intelligence/machine_learning/$1 [R=301,L]



RewriteRule ^style.css$ Framework/CSS/Style.php [L]
RewriteRule ^script.js$ Framework/JS/Script.php [L]

RewriteRule ^manifest\.json$ /Framework/Files/Manifest.json.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)\.js$ Framework/JS/Link/$1.js [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)\.ico$ Resource/$1.ico [L]

# Public /resource/... URLs map to the Resource/ tree without
# re-applying the generic media rules (avoids Resource/resource/... loops).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^resource/(.+)$ Resource/$1 [L]

RewriteCond %{DOCUMENT_ROOT}/Resource/$1 -d
RewriteCond %{DOCUMENT_ROOT}/Resource/$1/index.jpg -f
RewriteRule ^(.*?)\.jpg$ Resource/$1/index.jpg [L]

RewriteCond %{DOCUMENT_ROOT}/Resource/$1 -d
RewriteCond %{DOCUMENT_ROOT}/Resource/$1/index.svg -f
RewriteRule ^(.*?)\.svg$ Resource/$1/index.svg [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/Resource/$1.jpg -f
RewriteRule ^(.+)\.jpg$ Resource/$1.jpg [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/Resource/$1.png -f
RewriteRule ^(.+)\.png$ Resource/$1.png [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/Resource/$1.svg -f
RewriteRule ^(.+)\.svg$ Resource/$1.svg [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/File%{REQUEST_URI} -f
RewriteRule ^(.+)$ File/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/Site%{REQUEST_URI} -f
RewriteRule ^(.+)$ Site/$1 [L]

RewriteRule ^(.*?)\.json$ Framework/HTML/Component.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)$ Framework/HTML/Page.php [L]
